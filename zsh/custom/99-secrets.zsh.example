# ~/.oh-my-zsh/custom/99-secrets.zsh
# IMPORTANT: This file should contain sensitive information
# DO NOT commit this file to version control
# Add this file to your .gitignore if your dotfiles are in git

# ============================================================================
# API Keys and Tokens
# ============================================================================

# GitHub Token (for CLI operations)
# export GITHUB_TOKEN="your_github_token_here"

# OpenAI API Key (if using AI tools)
# export OPENAI_API_KEY="your_openai_key_here"

# ============================================================================
# Cloud Provider Credentials
# ============================================================================

# AWS Configuration (alternatively use aws configure)
# export AWS_ACCESS_KEY_ID="your_aws_access_key"
# export AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
# export AWS_DEFAULT_REGION="your_preferred_region"

# Google Cloud Project
# export GOOGLE_CLOUD_PROJECT="your_gcp_project_id"

# Azure Subscription
# export AZURE_SUBSCRIPTION_ID="your_azure_subscription_id"

# ============================================================================
# Database Connections
# ============================================================================

# Production Database URLs (use with extreme caution)
# export PROD_DATABASE_URL="postgresql://user:pass@host:port/db"
# export STAGING_DATABASE_URL="postgresql://user:pass@host:port/db"

# ============================================================================
# Development Tokens and Keys
# ============================================================================

# Slack Bot Token (for development integrations)
# export SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"

# Stripe API Keys (use test keys for development)
# export STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_key"
# export STRIPE_SECRET_KEY="sk_test_your_stripe_secret"

# ============================================================================
# Company/Project Specific
# ============================================================================

# Example: Kubernetes clusters for different projects
# export KUBECONFIG_PROD="$HOME/.kube/prod-config"
# export KUBECONFIG_STAGING="$HOME/.kube/staging-config"

# ============================================================================
# SSH Keys and Certificates
# ============================================================================

# Add SSH keys to agent (uncomment and modify as needed)
# ssh-add ~/.ssh/id_rsa_work 2>/dev/null
# ssh-add ~/.ssh/id_rsa_personal 2>/dev/null

# ============================================================================
# VPN and Network Configuration
# ============================================================================

# Company VPN settings
# export COMPANY_VPN_SERVER="vpn.company.com"
# export COMPANY_VPN_USER="your_username"

# ============================================================================
# Development Environment Overrides
# ============================================================================

# Override default ports if needed
# export API_PORT=8080
# export DB_PORT=5433
# export REDIS_PORT=6380

# Development database credentials
# export DEV_DB_USER="devuser"
# export DEV_DB_PASS="devpass"
# export DEV_DB_NAME="devdb"

# ============================================================================
# Personal Preferences
# ============================================================================

# Your personal Git configuration
# export GIT_AUTHOR_NAME="Mango Habanero"
# export GIT_AUTHOR_EMAIL="main@mango-habanero.dev"
# export GIT_COMMITTER_NAME="Mango Habanero"
# export GIT_COMMITTER_EMAIL="main@mango-habanero.dev"

# ============================================================================
# Usage Notes:
# ============================================================================
# 1. Copy this file to ~/.oh-my-zsh/custom/99-secrets.zsh
# 2. Uncomment and fill in the values you need
# 3. Make sure this file is not readable by others: chmod 600 ~/.oh-my-zsh/custom/99-secrets.zsh
# 4. Never commit this file to version control
# 5. Consider using a password manager or vault for production secrets